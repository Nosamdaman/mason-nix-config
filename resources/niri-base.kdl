// This is my niri configuration

// Startup applications
spawn-at-startup "swaybg" "--output" "*" "--mode" "fill" "--image" "/home/mason/.config/niri/wallpaper"
spawn-at-startup "ironbar"
spawn-at-startup "thunar" "--daemon"
spawn-at-startup "mako"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"

// Prefer server-side decorations
prefer-no-csd

// Configure blur
blur {
    passes 3
    offset 6
}

// Configure layout-related settings
layout {
    gaps 4

    empty-workspace-above-first

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.33333; }

    focus-ring { off; }

    border {
        on
        width 2
        active-color "2AA198"
        inactive-color "#586E75"
        urgent-color "#DC322F"
    }

    tab-indicator {
        width 4
        gap 4
        gaps-between-tabs 4
        corner-radius 2
        place-within-column
        length total-proportion=1.0
    }

    background-color "#000000"
}

// Configure rounded-corners and X-Ray
window-rule {
    match app-id=".*"
    geometry-corner-radius 5
    clip-to-geometry true
    background-effect {
        xray false
    }
}

// Change style for floating windows
window-rule {
    match is-floating=true

    border { active-color "#6C71C4"; }

    shadow { on; }
}

// Configure VRR for games
window-rule {
    match app-id="steam_app_.*"
    match app-id="cs2"
    variable-refresh-rate true
}

// Ensure that rofi gets blurred properly
layer-rule {
    match namespace="rofi"
    background-effect {
        blur true
        xray false
    }
}

// Ensure that mako notifications get blurred properly
layer-rule {
    match namespace="notifications"
    background-effect {
        blur true
        xray false
    }
}

// Configure our keybindings
binds {
    // Show hotkey help
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Hotkeys for launching programs
    Mod+Return hotkey-overlay-title="Open a Terminal" { spawn "foot"; }
    Mod+Space hotkey-overlay-title="Run an Application" { spawn "rofi" "-show-icons" "-show" "drun"; }
    Mod+E hotkey-overlay-title="Open File Browser" { spawn "thunar"; }

    // Basic movement is done with Mod + Vim or arrow keys
    Mod+Left { focus-column-left-or-last; }
    Mod+Down { focus-window-or-workspace-down; }
    Mod+Up { focus-window-or-workspace-up; }
    Mod+Right { focus-column-right-or-first; }
    Mod+H { focus-column-left-or-last; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+L { focus-column-right-or-first; }

    // Add shift in order to move columns around
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Down { move-column-to-workspace-down; }
    Mod+Shift+Up { move-column-to-workspace-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-column-to-workspace-down; }
    Mod+Shift+K { move-column-to-workspace-up; }
    Mod+Shift+L { move-column-right; }

    // Add alt in order to move individual windows
    Mod+Alt+Left { consume-or-expel-window-left; }
    Mod+Alt+Down { move-window-down-or-to-workspace-down; }
    Mod+Alt+Up { move-window-up-or-to-workspace-up; }
    Mod+Alt+Right { consume-or-expel-window-right; }
    Mod+Alt+H { consume-or-expel-window-left; }
    Mod+Alt+J { move-window-down-or-to-workspace-down; }
    Mod+Alt+K { move-window-up-or-to-workspace-up; }
    Mod+Alt+L { consume-or-expel-window-right; }

    // Use Ctrl + all the previous bindings to navigate multiple monitors
    Mod+Ctrl+Left { focus-monitor-left; }
    Mod+Ctrl+Down { focus-monitor-down; }
    Mod+Ctrl+Up { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+J { focus-monitor-down; }
    Mod+Ctrl+K { focus-monitor-up; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Shift+Left { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Down { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+Up { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+J { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+K { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }
    Mod+Ctrl+Alt+Left { move-window-to-monitor-left; }
    Mod+Ctrl+Alt+Down { move-window-to-monitor-down; }
    Mod+Ctrl+Alt+Up { move-window-to-monitor-up; }
    Mod+Ctrl+Alt+Right { move-window-to-monitor-right; }
    Mod+Ctrl+Alt+H { move-window-to-monitor-left; }
    Mod+Ctrl+Alt+J { move-window-to-monitor-down; }
    Mod+Ctrl+Alt+K { move-window-to-monitor-up; }
    Mod+Ctrl+Alt+L { move-window-to-monitor-right; }

    // Mod + P/N (Emacs bindings) is used to quickly switch workpaces; use shift to move the workpaces up or down
    Mod+P { focus-workspace-up; }
    Mod+N { focus-workspace-down; }
    Mod+Shift+P { move-workspace-up; }
    Mod+Shift+N { move-workspace-down; }

    // The mouse wheel can be used to navigate as well
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }

    // Use R to cycle between preset column and window sizes and +/- minus for fine manual adjustments
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Use C, M, and G to center, maximize, and grow colums respectively
    Mod+C { center-column; }
    Mod+M { maximize-window-to-edges; }
    Mod+G { expand-column-to-available-width; }

    // Use W to change the column display mode
    Mod+W { toggle-column-tabbed-display; }

    // Use F to handle floating windows
    Mod+F { toggle-window-floating; }
    Mod+Shift+F { switch-focus-between-floating-and-tiling; }

    // Use V to manage the clipboard history
    Mod+V { spawn-sh "cliphist list | rofi -dmenu -p \"Clipboard History\" | cliphist decode | wl-copy"; }

    // O opens the overview
    Mod+O repeat=false { toggle-overview; }

    // Q closes windows
    Mod+Q repeat=false { close-window; }

    // Screenshot bindings
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Set media keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // Applications such as remote-desktop clients and software KVM switches may
    // request that niri stops processing the keyboard shortcuts defined here
    // so they may, for example, forward the key presses as-is to a remote machine.
    // It's a good idea to bind an escape hatch to toggle the inhibitor,
    // so a buggy application can't hold your session hostage.
    //
    // The allow-inhibiting=false property can be applied to other binds as well,
    // which ensures niri always processes them, even when an inhibitor is active.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}

// Include the global configuration
include "/etc/niri/config.kdl"
